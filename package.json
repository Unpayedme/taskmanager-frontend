{
  "name": "taskmanager-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "A private task workspace with secure authentication and personal task management",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "johnleexd <johnlyyjazzman@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.13.6",
    "quasar": "^2.34.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@quasar/app-vite": "^3.10.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "taskmanager"
}
